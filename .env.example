# Copy to .env.local for development; never commit actual credentials.
DATABASE_URL=postgresql://personalwebsite:change-me@127.0.0.1:5432/personalwebsite
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only behind Nginx that overwrites X-Real-IP, with Node bound to loopback.
TRUST_PROXY=0
